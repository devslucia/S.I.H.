generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  MEDICO
  ENFERMERO
  ANESTESIOLOGO
  INSTRUMENTADOR
  ADMISION
  FACTURACION
  FARMACIA
  SECRETARIA
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_CONVIVENCIAL
}

enum TipoCama {
  ESTANDAR
  TERAPIA_INTENSIVA
  GUARDIA
}

enum EstadoCama {
  LIBRE
  OCUPADA
  EN_LIMPIEZA
  FUERA_DE_SERVICIO
}

enum TipoBeneficiario {
  TITULAR
  FAMILIAR
}

enum TipoIngreso {
  PROGRAMADO
  URGENCIA
  GUARDIA
  DERIVACION
}

enum EstadoInternacion {
  ACTIVA
  EN_QUIROFANO
  POSTQUIRURGICO
  ALTA_MEDICA
  FACTURADA
  FALLECIDO
}

enum TipoPrescripcion {
  MEDICACION
  DIETA
  ESTUDIO
  PRACTICA
  ACTIVIDAD
  OTRA
}

enum EstadoPrescripcion {
  ACTIVA
  SUSPENDIDA
  COMPLETADA
  BLOQUEADA_ALERGIA
}

enum TipoControl {
  SIGNOS_VITALES
  BALANCE_LIQUIDOS
  GLUCEMIA
  PESO
  MONITOREO_RESP
  CURACION
  NOTA_LIBRE
}

enum SeccionEnfermeria {
  SIGNOS_VITALES_INGRESOS_EGRESOS
  MATERIAL_DESCARTABLE
  MEDICACION_ORAL
  MEDICACION_ENDOVENOSA
  MEDICACION_IM_SC
}

enum CondicionEgreso {
  MEJORADO
  CURADO
  SIN_CAMBIOS
  DERIVADO
  FALLECIDO
}

enum DestinoEgreso {
  DOMICILIO
  INT_DOMICILIARIA
  OTRO_EFECTOR
  UTI
}

enum TipoCirugia {
  PROGRAMADA
  URGENCIA
  EMERGENCIA
}

enum EstadoCirugia {
  PROGRAMADA
  EN_CURSO
  COMPLETADA
  REPROGRAMADA
  CANCELADA
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  AJUSTE
  VENCIMIENTO
}

enum OrigenCargo {
  MEDICACION
  PRACTICA
  QUIROFANO
  ANESTESIA
  CAMA
  MATERIAL
  DESCARTABLE
  ESTUDIO
  GUARDIA
  OTRO
}

enum TipoEpisodio {
  INTERNACION
  CONSULTA
  GUARDIA
}

enum EstadoEpisodio {
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum EstadoGuardia {
  EN_ESPERA
  EN_ATENCION
  ATENDIDO
  ANULADO
}

enum DisposicionEgresoGuardia {
  ALTA
  INTERNACION
  DERIVACION
  OBITO
}

enum EstadoInterconsulta {
  SOLICITADA
  RESPONDIDA
  CANCELADA
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  EN_CONSULTA
  COMPLETADO
  CANCELADO
  NO_ASISTIO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model Usuario {
  id                       String                         @id @default(uuid())
  nombre                   String
  apellido                 String?
  email                    String                         @unique
  password                 String
  rol                      Rol
  matricula                String?
  especialidad             String?
  activo                   Boolean                        @default(true)
  createdAt                DateTime                       @default(now())
  evoluciones              Evolucion[]
  prescripciones           Prescripcion[]
  controlesEnfermeria      ControlEnfermeria[]
  aplicaciones             AplicacionMedicamento[]
  firmasDocumento          FirmaDocumento[]
  internacionesTratadas    InternacionMedicoTratante[]
  cirugiasInstrumentadas   Cirugia[]                      @relation("InstrumentadorCirugia")
  cirugiasCirculante       Cirugia[]                      @relation("CirculanteCirugia")
  secretariasAsignadas     SecretariaMedico[]             @relation("MedicoSecretarias")
  medicosAsignados         SecretariaMedico[]             @relation("SecretariaMedicos")
  horariosConsultorio      HorarioMedicoConsultorio[]
  turnosComoMedico         TurnoConsultorio[]             @relation("MedicoTurnos")
  turnosComoSecretaria     TurnoConsultorio[]             @relation("SecretariaTurnos")
  plantillasProtocolo      PlantillaProtocoloQuirurgico[]
  solicitudesInterconsulta Interconsulta[]                @relation("SolicitanteInterconsultas")
  interconsultasAsignadas  Interconsulta[]                @relation("EspecialistaInterconsultas")
  notificaciones           Notificacion[]
  guardiasAtendidas        EpisodioGuardiaMeta[]          @relation("MedicoGuardia")
  guardiasRegistradas      EpisodioGuardiaMeta[]          @relation("RegistroIngresoGuardia")
}

model Paciente {
  id                String             @id @default(uuid())
  dni               String             @unique
  apellido          String
  nombre            String
  sexo              Sexo
  fechaNac          DateTime
  cuil              String?
  domicilio         String?
  localidad         String?
  provincia         String?
  telefono          String?
  email             String?
  grupoSangre       String?
  estadoCivil       EstadoCivil?
  alergias          Alergia[]
  internaciones     Internacion[]
  historiasClinicas HistoriaClinica[]
  turnosConsultorio TurnoConsultorio[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Alergia {
  id          String   @id @default(uuid())
  pacienteId  String
  paciente    Paciente @relation(fields: [pacienteId], references: [id])
  sustancia   String
  tipo        String   @default("MEDICAMENTO")
  severidad   String?
  observacion String?
  createdAt   DateTime @default(now())
}

model ObraSocial {
  id                         String                 @id @default(uuid())
  codigo                     String                 @unique
  nombre                     String
  sigla                      String
  descripcion                String
  razonSocial                String
  domicilio                  String?
  localidad                  String?
  tipoContribucion           TipoContribucion       @default(CONSUMIDOR_FINAL)
  tipoIva                    TipoIva                @default(IVA_21)
  cuit                       String
  estadoAmbulatorio          EstadoCobertura        @default(ACTIVA)
  estadoInternacion          EstadoCobertura        @default(ACTIVA)
  porcentajeDescMedicamentos Decimal                @default(0) @db.Decimal(5, 2)
  activa                     Boolean                @default(true)
  convenios                  Convenio[]
  nomencladorObraSocial      NomencladorObraSocial?
  galenos                    GalenoObraSocial[]
  nomencladorEspecifico      NomencladorItem[]
  internaciones              Internacion[]
  turnosConsultorio          TurnoConsultorio[]
  episodiosGuardia           EpisodioGuardiaMeta[]
}

enum TipoContribucion {
  INSCRIPTO
  NO_INSCRIPTO
  EXENTO
  MONOTRIBUTO
  CONSUMIDOR_FINAL
}

enum TipoIva {
  IVA_0
  IVA_10_5
  IVA_21
}

enum EstadoCobertura {
  ACTIVA
  SUSPENDIDA
}

enum AlcanceNomenclador {
  NACIONAL
  ESPECIFICA
}

model Convenio {
  id            String          @id @default(uuid())
  obraSocialId  String
  obraSocial    ObraSocial      @relation(fields: [obraSocialId], references: [id])
  nomencladorId String
  nomenclador   NomencladorItem @relation(fields: [nomencladorId], references: [id])
  valor         Decimal
  vigenciaDesde DateTime
  vigenciaHasta DateTime?
}

model Sector {
  id     String @id @default(uuid())
  nombre String
  codigo String @unique
  camas  Cama[]
}

model Cama {
  id            String        @id @default(uuid())
  numero        String
  sectorId      String
  sector        Sector        @relation(fields: [sectorId], references: [id])
  tipo          TipoCama
  estado        EstadoCama    @default(LIBRE)
  internaciones Internacion[]

  @@index([estado])
}

model Internacion {
  id                          String                      @id @default(uuid())
  numero                      Int                         @unique @default(autoincrement())
  pacienteId                  String
  paciente                    Paciente                    @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  camaId                      String?
  cama                        Cama?                       @relation(fields: [camaId], references: [id])
  obraSocialId                String?
  obraSocial                  ObraSocial?                 @relation(fields: [obraSocialId], references: [id])
  nroAfiliado                 String?
  tipoBeneficiario            TipoBeneficiario?
  fechaIngreso                DateTime                    @default(now())
  fechaEgreso                 DateTime?
  motivoIngreso               String?
  peso                        Float?
  diagnosticoCirugia          String?
  diagnosticoCIE              String?
  medicoSolicitante           String?
  medicosTratantesInternacion InternacionMedicoTratante[]
  tipoIngreso                 TipoIngreso
  estado                      EstadoInternacion           @default(ACTIVA)
  pases                       PaseInterno[]
  histClinica                 HistoriaClinica?
  episodio                    Episodio?
  cirugias                    Cirugia[]
  cargosFacturacion           CargoFacturacion[]
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@index([pacienteId])
  @@index([estado, camaId])
}

model InternacionMedicoTratante {
  id              String      @id @default(uuid())
  internacionId   String
  internacion     Internacion @relation(fields: [internacionId], references: [id], onDelete: Cascade)
  medicoId        String
  medico          Usuario     @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  fechaAsignacion DateTime    @default(now())

  @@unique([internacionId, medicoId])
  @@index([internacionId])
  @@index([medicoId])
}

model PaseInterno {
  id            String      @id @default(uuid())
  internacionId String
  internacion   Internacion @relation(fields: [internacionId], references: [id])
  camaAnterior  String?
  camaNueva     String
  sector        String
  fecha         DateTime    @default(now())
  tipoPension   String?
}

model HistoriaClinica {
  id                     String                   @id @default(uuid())
  internacionId          String?                  @unique
  internacion            Internacion?             @relation(fields: [internacionId], references: [id])
  pacienteId             String?
  paciente               Paciente?                @relation(fields: [pacienteId], references: [id])
  anamnesis              Anamnesis[]
  evoluciones            Evolucion[]
  prescripciones         Prescripcion[]
  controlesEnfermeria    ControlEnfermeria[]
  hojaEnfermeria         HojaEnfermeria[]
  valoracionPreanestesia ValoracionPreanestesia[]
  protocoloAnestesia     ProtocoloAnestesia[]
  epicrisis              Epicrisis[]
  episodios              Episodio[]
  createdAt              DateTime                 @default(now())

  @@index([pacienteId])
}

model Episodio {
  id            String          @id @default(uuid())
  hcId          String
  hc            HistoriaClinica @relation(fields: [hcId], references: [id])
  tipo          TipoEpisodio
  internacionId String?         @unique
  internacion   Internacion?    @relation(fields: [internacionId], references: [id])
  numero        Int             @default(autoincrement())
  motivoIngreso String?
  diagnostico   String?
  estado        EstadoEpisodio  @default(EN_CURSO)
  fechaInicio   DateTime        @default(now())
  fechaFin      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  anamnesis              Anamnesis[]
  evoluciones            Evolucion[]
  prescripciones         Prescripcion[]
  controlesEnfermeria    ControlEnfermeria[]
  hojaEnfermeria         HojaEnfermeria[]
  valoracionPreanestesia ValoracionPreanestesia?
  protocoloAnestesia     ProtocoloAnestesia?
  epicrisis              Epicrisis?
  turnoConsultorio       TurnoConsultorio?
  interconsultas         Interconsulta[]
  guardiaMeta            EpisodioGuardiaMeta?

  @@index([hcId, fechaInicio])
  @@index([tipo])
}

model EpisodioGuardiaMeta {
  id                      String                    @id @default(uuid())
  episodioId              String                    @unique
  episodio                Episodio                  @relation(fields: [episodioId], references: [id], onDelete: Cascade)
  estadoGuardia           EstadoGuardia             @default(EN_ESPERA)
  prioridad               Int                       @default(4)
  fechaHoraInicioAtencion DateTime?
  fechaHoraEgreso         DateTime?
  diagnosticoIngreso      String?
  diagnosticoEgreso       String?
  disposicionEgreso       DisposicionEgresoGuardia?
  motivoAnulacion         String?
  medicoId                String?
  medico                  Usuario?                  @relation("MedicoGuardia", fields: [medicoId], references: [id])
  usuarioIngresoId        String
  usuarioIngreso          Usuario                   @relation("RegistroIngresoGuardia", fields: [usuarioIngresoId], references: [id])
  obraSocialId            String?
  obraSocial              ObraSocial?               @relation(fields: [obraSocialId], references: [id])

  @@index([estadoGuardia])
  @@index([episodioId, fechaHoraInicioAtencion])
}

model Interconsulta {
  id                  String              @id @default(uuid())
  episodioId          String
  episodio            Episodio            @relation(fields: [episodioId], references: [id], onDelete: Cascade)
  medicoSolicitanteId String
  medicoSolicitante   Usuario             @relation("SolicitanteInterconsultas", fields: [medicoSolicitanteId], references: [id])
  especialidad        String
  especialistaId      String?
  especialista        Usuario?            @relation("EspecialistaInterconsultas", fields: [especialistaId], references: [id])
  motivo              String
  estado              EstadoInterconsulta @default(SOLICITADA)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([episodioId])
  @@index([especialistaId])
}

model HorarioMedicoConsultorio {
  id           String    @id @default(uuid())
  medicoId     String
  medico       Usuario   @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  dia          DiaSemana
  horaInicio   String
  horaFin      String
  intervaloMin Int       @default(30)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@unique([medicoId, dia, horaInicio])
  @@index([medicoId])
}

model SecretariaMedico {
  id              String   @id @default(uuid())
  secretariaId    String
  secretaria      Usuario  @relation("SecretariaMedicos", fields: [secretariaId], references: [id], onDelete: Cascade)
  medicoId        String
  medico          Usuario  @relation("MedicoSecretarias", fields: [medicoId], references: [id], onDelete: Cascade)
  fechaAsignacion DateTime @default(now())

  @@unique([secretariaId, medicoId])
  @@index([secretariaId])
  @@index([medicoId])
}

model TurnoConsultorio {
  id           String      @id @default(uuid())
  medicoId     String
  medico       Usuario     @relation("MedicoTurnos", fields: [medicoId], references: [id])
  pacienteId   String
  paciente     Paciente    @relation(fields: [pacienteId], references: [id])
  secretariaId String?
  secretaria   Usuario?    @relation("SecretariaTurnos", fields: [secretariaId], references: [id])
  obraSocialId String?
  obraSocial   ObraSocial? @relation(fields: [obraSocialId], references: [id])
  fecha        DateTime
  hora         String
  motivo       String?
  estado       EstadoTurno @default(PENDIENTE)
  asistio      Boolean?
  episodioId   String?     @unique
  episodio     Episodio?   @relation(fields: [episodioId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([medicoId, fecha])
  @@index([pacienteId])
  @@index([fecha, estado])
  @@index([secretariaId, fecha])
}

model Anamnesis {
  id                   String          @id @default(uuid())
  hcId                 String
  hc                   HistoriaClinica @relation(fields: [hcId], references: [id])
  episodioId           String?         @unique
  episodio             Episodio?       @relation(fields: [episodioId], references: [id])
  motivoConsulta       String?
  enfermedadActual     String?
  antecPatologicos     String?
  antecFamiliares      String?
  habitosToxicos       String?
  factoresRiesgoCV     String?
  otros                String?
  estadoGeneral        String?
  signosVitalesIngreso Json?
  pielFaneras          String?
  cabezaCuello         String?
  torax                String?
  apRespiratorio       String?
  apCardiovascular     String?
  abdomen              String?
  snervioso            String?
  extremidades         String?
  diagPresuntivo       String?
  diagDiferencial      String?
  planEvaluacion       String?
  planTerapeutico      String?
  firmadoAt            DateTime?
  firmadoPor           String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([hcId])
}

model Evolucion {
  id         String          @id @default(uuid())
  hcId       String
  hc         HistoriaClinica @relation(fields: [hcId], references: [id])
  episodioId String?
  episodio   Episodio?       @relation(fields: [episodioId], references: [id])
  fecha      DateTime        @default(now())
  contenido  String
  usuarioId  String
  usuario    Usuario         @relation(fields: [usuarioId], references: [id])
  firmada    Boolean         @default(false)
  firmadaAt  DateTime?

  @@index([hcId])
}

model Prescripcion {
  id               String                  @id @default(uuid())
  hcId             String
  hc               HistoriaClinica         @relation(fields: [hcId], references: [id])
  episodioId       String?
  episodio         Episodio?               @relation(fields: [episodioId], references: [id])
  fecha            DateTime                @default(now())
  tipo             TipoPrescripcion
  droga            String?
  dosis            String?
  unidad           String?
  frecuencia       String?
  via              String?
  duracion         String?
  dieta            String?
  estudio          String?
  practica         String?
  descripcion      String?
  estado           EstadoPrescripcion      @default(ACTIVA)
  bloqueadaAlergia Boolean                 @default(false)
  usuarioId        String
  usuario          Usuario                 @relation(fields: [usuarioId], references: [id])
  aplicaciones     AplicacionMedicamento[]
  createdAt        DateTime                @default(now())

  @@index([hcId])
  @@index([estado])
}

model Notificacion {
  id         String   @id @default(uuid())
  userId     String?
  user       Usuario? @relation(fields: [userId], references: [id], onDelete: Cascade)
  rolDestino String?
  titulo     String
  mensaje    String
  link       String?
  leida      Boolean  @default(false)
  tipo       String   @default("NUEVA_INDICACION")
  refId      String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, leida])
  @@index([rolDestino, leida])
}

model AplicacionMedicamento {
  id                 String            @id @default(uuid())
  prescripcionId     String?
  prescripcion       Prescripcion?     @relation(fields: [prescripcionId], references: [id])
  fecha              DateTime
  hora               String
  stockItemId        String?
  stockItem          StockItem?        @relation(fields: [stockItemId], references: [id])
  cantidadDescontada Decimal?
  motivo             String?
  enfermeroId        String
  enfermero          Usuario           @relation(fields: [enfermeroId], references: [id])
  cargo              CargoFacturacion?
  createdAt          DateTime          @default(now())
}

model ControlEnfermeria {
  id          String          @id @default(uuid())
  hcId        String
  hc          HistoriaClinica @relation(fields: [hcId], references: [id])
  episodioId  String?
  episodio    Episodio?       @relation(fields: [episodioId], references: [id])
  fecha       DateTime        @default(now())
  hora        String
  tipo        TipoControl
  datos       Json
  observacion String?
  alertas     Json?
  usuarioId   String
  usuario     Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([hcId])
}

model HojaEnfermeria {
  id             String             @id @default(uuid())
  hcId           String
  hc             HistoriaClinica    @relation(fields: [hcId], references: [id])
  episodioId     String?
  episodio       Episodio?          @relation(fields: [episodioId], references: [id])
  fecha          DateTime
  seccion        SeccionEnfermeria
  item           String
  dosis          String?
  via            String?
  marcasHorarias Json
  stockItemId    String?
  stockItem      StockItem?         @relation(fields: [stockItemId], references: [id])
  cargos         CargoFacturacion[]
  createdAt      DateTime           @default(now())

  @@index([hcId])
}

model RangoVital {
  id        String   @id @default(uuid())
  parametro String
  minimo    Float
  maximo    Float
  unidad    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parametro])
}

model ValoracionPreanestesia {
  id                       String          @id @default(uuid())
  hcId                     String
  hc                       HistoriaClinica @relation(fields: [hcId], references: [id])
  episodioId               String?         @unique
  episodio                 Episodio?       @relation(fields: [episodioId], references: [id])
  cirugiaId                String?
  peso                     Float?
  talla                    Float?
  diagnosticoPreoperatorio String?
  cirugiaPropuestaTipo     String? // "programada" | "urgencia"
  cirugiaPropuestaDesc     String?
  antecQuirurgicos         String?
  antecClinicos            Json?
  enfermedadesTratamiento  String?
  examenFisico             Json?
  laboratorio              String?
  laboratorioFecha         DateTime?
  scoreASA                 Int?
  anestesiaSugerida        String?
  comentarios              String?
  anestesiologoId          String?
  firmadaAt                DateTime?
  createdAt                DateTime        @default(now())

  @@index([hcId])
}

model ProtocoloAnestesia {
  id         String          @id @default(uuid())
  hcId       String
  hc         HistoriaClinica @relation(fields: [hcId], references: [id])
  episodioId String?         @unique
  episodio   Episodio?       @relation(fields: [episodioId], references: [id])
  cirugiaId  String?
  cirugia    Cirugia?        @relation(fields: [cirugiaId], references: [id])

  // Bloque 1 - Equipo
  anestesiologo          String?
  matriculaAnestesiologo String?
  cirujano               String?
  matriculaCirujano      String?
  ayudantes              String?
  fechaCirugia           DateTime?

  // Bloque 2 - Evaluación preanestésica
  alergiaDetalle          String?
  antecedentesImportancia String?
  clasificacionASA        String?
  esEmergencia            Boolean @default(false)
  grupoSangre             String?
  ayunoHoras              Int?
  // Legacy (migrados a ayunoHoras con GREATEST(sólidos, líquidos); se conservan para lectura de protocolos viejos)
  ayunoSolidos            Int?
  ayunoLiquidos           Int?
  ultimaIngesta           String?
  estadoPsiquico          String?
  premedicacion           Json?
  preoxigenacion          Boolean @default(false)
  preoxigenacionDetalle   String?
  signosVitaPreop         Json?
  mallampati              String?
  distTiromentoniana      Float?
  aperturaBucal           String?
  checklistEquipoAnes     Boolean @default(false)
  checklistReanimacion    Boolean @default(false)
  checklistMonitores      Boolean @default(false)
  checklistPosicion       Boolean @default(false)

  // Bloque 3 - Técnica
  tecnicaAnestesia      String[]
  tipoAnestesia         String?
  tipoAnestesiaDetalle  String?
  nivelBloqueo          String?
  lateralidad           String?
  nervioPlexo           String?
  tecnicaBloqueo        String?
  zonaLocal             String?
  nivelSedacion         String?
  // Conductiva
  tipoConductiva        String?
  posicionPuncion       String?
  sitioPuncion          String?
  agujaDetalle          String?
  cateter               Boolean?
  farmacoConductiva     String?
  // General
  viaInduccion          String?
  manejoViaAerea        String?
  intubacion            Boolean  @default(false)
  intubacionSubtipo     String?
  entubacionEsofagica   Boolean  @default(false)
  canulaFaringealTipo   String?
  nroTubo               String?
  conManguito           Boolean?
  dificultadViaAerea    Boolean?
  detalleViaAerea       String?
  modalidadVentilatoria String?
  modalidadVentFranja   Json?
  fio2                  Float?
  oxigenoFlujo          Float?

  // Bloque 4 - Registro
  drogas        DrogaAnestesia[]
  signosVitales Json?

  // Bloque 4 - Datos físicos
  peso  Float?
  talla Float?
  imc   Float?

  // Bloque 5 - Balance
  liquidosIngresados Json?
  diuresis           Int?
  perdidaSanguinea   String?
  perdidaSanguineaML Int?
  otrosEgresos       String?
  posicionOperatoria String?
  sondaNasogastrica  Boolean @default(false)
  sondaVesical       Boolean @default(false)
  tipoCirugia        String?
  observaciones      String?

  // Bloque 6 - Recuperación
  estadoEgreso       String[]
  destinoPaciente    String?
  aldreteActividad   Int?
  aldreteRespiracion Int?
  aldreteCirculacion Int?
  aldreteConciencia  Int?
  aldreteSpo2        Int?

  // Firma
  nombreFirmante    String?
  matriculaFirmante String?
  firmadoEn         DateTime?
  firmadoPor        String?
  firmado           Boolean   @default(false)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([hcId])
}

model DrogaAnestesia {
  id                 String             @id @default(uuid())
  protocoloId        String
  protocolo          ProtocoloAnestesia @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  categoria          String
  nombre             String
  dosis              Float?
  unidad             String?
  via                String?
  horaAdministracion DateTime?
  observaciones      String?
}

model Epicrisis {
  id                     String           @id @default(uuid())
  hcId                   String
  hc                     HistoriaClinica  @relation(fields: [hcId], references: [id])
  episodioId             String?          @unique
  episodio               Episodio?        @relation(fields: [episodioId], references: [id])
  diagIngreso            String?
  diagEgreso             String?
  codigosCIE             String[]
  resumenClinico         String?
  estudiosRealizados     String?
  tratamientosRealizados String?
  proximoControlFecha    DateTime?
  proximoControlLugar    String?
  proximoControlMedico   String?
  pendiente              String?
  condicionEgreso        CondicionEgreso?
  destino                DestinoEgreso?
  medicacionAlta         Json[]
  indicacionesAlta       String?
  medicoId               String?
  firmadaAt              DateTime?
  createdAt              DateTime         @default(now())

  @@index([hcId])
}

model Quirofano {
  id         String    @id @default(uuid())
  numero     Int       @unique
  nombre     String
  piso       String?
  disponible Boolean   @default(true)
  cirugias   Cirugia[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Cirugia {
  id                         String        @id @default(uuid())
  internacionId              String
  internacion                Internacion   @relation(fields: [internacionId], references: [id])
  quirofanoId                String?
  quirofano                  Quirofano?    @relation(fields: [quirofanoId], references: [id], onDelete: Restrict)
  fechaProgramada            DateTime
  horaProgramada             String
  tipo                       TipoCirugia
  estado                     EstadoCirugia @default(PROGRAMADA)
  cirujanoId                 String?
  ayudante1Id                String?
  ayudante2Id                String?
  anestesiologoId            String?
  instrumentadorId           String?
  instrumentador             Usuario?      @relation("InstrumentadorCirugia", fields: [instrumentadorId], references: [id])
  instrumentadorNombreLegado String?
  circulanteId               String?
  circulante                 Usuario?      @relation("CirculanteCirugia", fields: [circulanteId], references: [id])
  circulanteNombreLegado     String?
  diagnosticoPreop           String?
  diagnosticoPostop          String?
  procedimiento              String?
  intervencionesAgregadas    String?
  hallazgos                  String?
  horaInicio                 String?
  horaFin                    String?
  muestrasPatologicas        Int?
  muestrasBacteriologicas    Int?
  arcoC                      Boolean       @default(false)
  arm                        Boolean       @default(false)
  ecografo                   Boolean       @default(false)
  scoreASA                   Int?
  observaciones              String?
  muestrasPatologicasObs     String?
  muestrasBacteriologicasObs String?

  // Parto/Cesárea
  horaNacimiento      String?
  sexoRN              String?
  pesoRN              Int?
  apgar1              Int?
  apgar5              Int?
  tipoParto           String?
  complicacionesParto String?

  // Balance intraoperatorio (JSON arrays)
  balanceIngresos Json?
  balanceEgresos  Json?

  // Signos vitales intraoperatorios (JSON array)
  signosVitalesIntraop Json?

  observacionesAnestesia String?
  posicionOperatoria     String?
  sondaNasogastrica      Boolean @default(false)
  sondaVesical           Boolean @default(false)
  diuresisIntraop        Int?
  sangrePerdida          String?

  // Evolución post operatoria inmediata
  evolucionPostInt String?

  // Indicaciones postoperatorias (JSON array)
  indicacionesPostoperatorias Json?

  implantes           Implante[]
  medicamentos        MedicamentoCirugia[]
  practicas           PracticaCirugia[]
  reprogramaciones    Reprogramacion[]
  protocolosAnestesia ProtocoloAnestesia[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([fechaProgramada, estado])
}

model Implante {
  id        String   @id @default(uuid())
  cirugiaId String
  cirugia   Cirugia  @relation(fields: [cirugiaId], references: [id])
  codigo    String
  nombre    String
  lote      String?
  modelo    String?
  lado      String?
  codigoCE  String?
  createdAt DateTime @default(now())
}

model Reprogramacion {
  id            String   @id @default(uuid())
  cirugiaId     String
  cirugia       Cirugia  @relation(fields: [cirugiaId], references: [id])
  fechaOriginal DateTime
  nuevaFecha    DateTime
  motivo        String
  registradoPor String
  createdAt     DateTime @default(now())
}

model MedicamentoCirugia {
  id              String     @id @default(uuid())
  cirugiaId       String
  cirugia         Cirugia    @relation(fields: [cirugiaId], references: [id])
  stockItemId     String?
  stockItem       StockItem? @relation(fields: [stockItemId], references: [id])
  nombre          String
  presentacion    String?
  cantidad        Decimal
  via             String?
  fechaAplicacion DateTime?
  horaAplicacion  String?
  observacion     String?
}

model PracticaCirugia {
  id             String   @id @default(uuid())
  cirugiaId      String
  cirugia        Cirugia  @relation(fields: [cirugiaId], references: [id])
  fecha          DateTime
  hora           String
  practica       String
  laboratorio    String?
  cargoPor       String?
  actoQuirurgico String?
}

model StockItem {
  id                  String                  @id @default(uuid())
  nombre              String
  nTroquel            String?
  principioActivo     String?
  presentacion        String?
  laboratorio         String?
  unidad              String
  stockActual         Decimal
  stockMinimo         Decimal
  stockMaximo         Decimal
  lote                String?
  vencimiento         DateTime?
  ubicacion           String?
  nomencladorCodigo   String?
  codAlfabeta         String?
  precioCompra        Decimal?
  precioVenta         Decimal?
  fraccion            Int?
  precioUnidadCompra  Decimal?
  precioUnidadVenta   Decimal?
  activo              Boolean                 @default(true)
  movimientos         MovimientoStock[]
  aplicaciones        AplicacionMedicamento[]
  medicamentosCirugia MedicamentoCirugia[]
  hojasEnfermeria     HojaEnfermeria[]
  cargosFacturacion   CargoFacturacion[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([nTroquel])
}

model MovimientoStock {
  id            String         @id @default(uuid())
  stockItemId   String
  stockItem     StockItem      @relation(fields: [stockItemId], references: [id])
  tipo          TipoMovimiento
  cantidad      Decimal
  motivo        String
  internacionId String?
  cirugiaId     String?
  usuarioId     String?
  createdAt     DateTime       @default(now())

  @@index([stockItemId, createdAt])
}

model NomencladorItem {
  id                         String                      @id @default(uuid())
  codigo                     String
  descripcion                String
  tipo                       String
  seccion                    String?
  capitulo                   String?
  uEspecialista              Decimal?
  uAyudantes                 Decimal?
  uAnestesista               Decimal?
  cantidadAyudantes          Int?
  gastos                     Decimal?
  total                      Decimal?
  notas                      String?
  activo                     Boolean                     @default(true)
  alcance                    AlcanceNomenclador          @default(NACIONAL)
  obraSocialId               String?
  obraSocial                 ObraSocial?                 @relation(fields: [obraSocialId], references: [id], onDelete: Restrict)
  convenios                  Convenio[]
  nomencladorObraSocialItems NomencladorObraSocialItem[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  cargos                     CargoFacturacion[]

  @@unique([codigo, obraSocialId])
  @@index([alcance])
  @@index([capitulo, seccion])
}

model GalenoObraSocial {
  id               String     @id @default(uuid())
  obraSocialId     String
  obraSocial       ObraSocial @relation(fields: [obraSocialId], references: [id], onDelete: Restrict)
  galenoQx         Decimal    @default(0) @db.Decimal(12, 2)
  gastosQx         Decimal    @default(0) @db.Decimal(12, 2)
  gastosPension    Decimal    @default(0) @db.Decimal(12, 2)
  otrosGastos      Decimal    @default(0) @db.Decimal(12, 2)
  galenoMedicacion Decimal    @default(0) @db.Decimal(12, 2)
  vigenciaDesde    DateTime   @db.Date
  vigenciaHasta    DateTime?  @db.Date
  activo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([obraSocialId, vigenciaDesde])
}

model NomencladorObraSocial {
  id           String                      @id @default(uuid())
  obraSocialId String                      @unique
  obraSocial   ObraSocial                  @relation(fields: [obraSocialId], references: [id], onDelete: Cascade)
  items        NomencladorObraSocialItem[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model NomencladorObraSocialItem {
  id                      String                @id @default(uuid())
  nomencladorObraSocialId String
  nomencladorObraSocial   NomencladorObraSocial @relation(fields: [nomencladorObraSocialId], references: [id], onDelete: Cascade)
  nomencladorItemId       String?
  nomencladorItem         NomencladorItem?      @relation(fields: [nomencladorItemId], references: [id], onDelete: SetNull)
  codigo                  String
  descripcion             String
  uEspecialista           Decimal?
  uAyudantes              Decimal?
  uAnestesista            Decimal?
  gastos                  Decimal?
  fijoEspecialista        Decimal?              @db.Decimal(12, 2)
  fijoAyudantes           Decimal?              @db.Decimal(12, 2)
  fijoAnestesista         Decimal?              @db.Decimal(12, 2)
  fijoGastos              Decimal?              @db.Decimal(12, 2)
  activo                  Boolean               @default(true)
  origen                  OrigenNomencladorOS   @default(COPIA_NACIONAL)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([nomencladorObraSocialId, codigo])
  @@index([codigo])
}

enum OrigenNomencladorOS {
  COPIA_NACIONAL
  PROPIA_OS
}

model CargoFacturacion {
  id                     String                 @id @default(uuid())
  internacionId          String
  internacion            Internacion            @relation(fields: [internacionId], references: [id])
  concepto               String
  cantidad               Decimal
  precioUnitario         Decimal
  total                  Decimal
  origen                 OrigenCargo
  aplicacionId           String?                @unique
  aplicacion             AplicacionMedicamento? @relation(fields: [aplicacionId], references: [id])
  stockItemId            String?
  stockItem              StockItem?             @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  hojaEnfermeriaId       String?
  hojaEnfermeria         HojaEnfermeria?        @relation(fields: [hojaEnfermeriaId], references: [id])
  fecha                  DateTime               @default(now())
  facturado              Boolean                @default(false)
  nomencladorId          String?
  nomenclador            NomencladorItem?       @relation(fields: [nomencladorId], references: [id])
  galenoQx               Decimal?
  honorariosEspecialista Decimal?
  honorariosAyudantes    Decimal?
  honorariosAnestesista  Decimal?
  gastosPractica         Decimal?
  funcionCodigo          String?
  valorBase              Decimal?               @db.Decimal(12, 2)
  galenoAplicado         Decimal?               @db.Decimal(12, 2)
  observacion            String?

  @@index([internacionId])
  @@index([facturado])
}

model FirmaDocumento {
  id        String   @id @default(uuid())
  tipoDoc   String
  docId     String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  hash      String
  timestamp DateTime @default(now())
}

model PlantillaProtocoloQuirurgico {
  id          String   @id @default(uuid())
  nombre      String
  descripcion String?
  medicoId    String
  medico      Usuario  @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([medicoId, nombre])
}
